{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "word-reference-source-v0.1.schema.json",
  "title": "Word Reference 0.1 Source",
  "description": "A strict, bounded collection of canonical source-scoped meaning and URL-reference assertions. Source, publisher, proof, verification, and trust values are assertions, not verified facts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "source_id",
    "records"
  ],
  "properties": {
    "protocol": {
      "const": "word-reference/0.1"
    },
    "source_id": {
      "$ref": "#/$defs/identifier"
    },
    "records": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._/-]{0,254}[A-Za-z0-9])?$"
    },
    "word": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[\\p{L}\\p{N}][\\p{L}\\p{N}\\p{M}]*(?:[-'’][\\p{L}\\p{N}][\\p{L}\\p{N}\\p{M}]*)*$",
      "$comment": "The regex is structural. NFKC-plus-lowercase canonical equality is an additional algorithmic requirement."
    },
    "language": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z]{2,8}(?:-[a-z0-9]{1,8})*$"
    },
    "bounded_assertion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F\\uD800-\\uDFFF]+$"
    },
    "bounded_proof": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "pattern": "^[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F\\uD800-\\uDFFF]+$"
    },
    "nullable_assertion": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/bounded_assertion"
        }
      ]
    },
    "nullable_proof": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/bounded_proof"
        }
      ]
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "word",
        "language",
        "definition"
      ],
      "properties": {
        "record_id": {
          "$ref": "#/$defs/identifier"
        },
        "word": {
          "$ref": "#/$defs/word"
        },
        "language": {
          "$ref": "#/$defs/language"
        },
        "definition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "pattern": "^[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F\\uD800-\\uDFFF]+$"
        },
        "references": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/reference"
          },
          "description": "Optional. Omission normalizes to an empty array."
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_id",
        "kind",
        "href"
      ],
      "properties": {
        "reference_id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "href": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "format": "iri",
          "allOf": [
            {
              "pattern": "^[^\\u0000-\\u001F\\u007F\\uD800-\\uDFFF]+$"
            },
            {
              "pattern": "^[hH][tT][tT][pP][sS]?://(?![^/?#]*@)(?:\\[[^\\]/?#@\\s]+\\]|[^/?#:@\\s]+)(?::[0-9]{1,5})?(?:[/?#]|$)"
            }
          ]
        },
        "asserted_by": {
          "$ref": "#/$defs/nullable_assertion",
          "description": "Optional. Omission normalizes to null."
        },
        "proof": {
          "$ref": "#/$defs/nullable_proof",
          "description": "Optional. Omission normalizes to null."
        },
        "verification": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[^\\u0000-\\u001F\\u007F\\uD800-\\uDFFF]+$",
          "description": "Optional import assertion only. The resolver ignores it and emits unverified."
        },
        "trust": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[^\\u0000-\\u001F\\u007F\\uD800-\\uDFFF]+$",
          "description": "Optional import assertion only. The resolver ignores it and emits untrusted."
        }
      }
    }
  }
}
