{
  "name": "@word-layer/agenttool",
  "version": "0.1.0",
  "description": "Local AgentTool Browser transports for the plural word-layer handoff protocol.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./protocol": {
      "types": "./dist/src/protocol.d.ts",
      "import": "./dist/src/protocol.js"
    },
    "./schema/*.json": "./schema/*.json"
  },
  "bin": {
    "agenttool-word": "./dist/bin/agenttool-word.js"
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:core": "bun run --cwd ../.. build",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./tests",
    "build": "bun run clean && tsc",
    "smoke": "node -e \"import('./dist/src/index.js').then(m=>{if(m.WORD_JSONL_PROTOCOL_VERSION!=='agenttool-word-jsonl/0.1')process.exit(1)})\"",
    "check:package": "bun install --frozen-lockfile && bun scripts/check-package.ts",
    "ci": "bun run build:core && bun run typecheck && bun run test && bun run build && bun run smoke && bun run check:package",
    "prepack": "bun run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cambridgetcg/word-layer.git",
    "directory": "integrations/agenttool"
  },
  "bugs": {
    "url": "https://github.com/cambridgetcg/word-layer/issues"
  },
  "homepage": "https://github.com/cambridgetcg/word-layer/tree/main/integrations/agenttool#readme",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@agenttool/browser": "0.5.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "word-layer": "file:vendor/word-layer-0.3.0.tgz",
    "zod": "4.4.3"
  },
  "bundleDependencies": [
    "word-layer"
  ],
  "devDependencies": {
    "@agenttool/browser": "0.5.0",
    "@types/bun": "^1.3.5",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.19",
    "bun": ">=1.3.5"
  },
  "license": "Apache-2.0",
  "sideEffects": false
}
